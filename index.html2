<!DOCTYPE html>
<html lang="en">
<head>
  <title>Grid Example</title>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>

  <style type="text/css">
    h1 {
      color: green;
    }

    #a1, #a4 {
      color: white;
      background: olive;
      font-size: 20px;
    }

    #a2, #a5 {
      color: white;
      background: maroon;
      font-size: 20px;
    }

    #a3, #a6 {
      color: white;
      background: fuchsia;
      font-size: 20px;
    }
  <body>
  <div class="container">
    <h1>Bootstrap Grid Example</h1>

    <div class="row">
      <div class="col-sm-4" id="a1">Column 1</div>
      <div class="col-sm-4" id="a2">Column 2</div>
      <div class="col-sm-4" id="a3">Column 3</div>
    </div>

    <div class="row">
      <div class="col-sm-4" id="a4">Column 4</div>
      <div class="col-sm-4" id="a5">Column 5</div>
      <div class="col-sm-4" id="a6">Column 6</div>
    </div>
  </div>
</body>
</html>
